<Window x:Class="IMediaApp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMediaApp"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Image Source="C:\Users\jusep\OneDrive\Рабочий стол\IMediaApp\IMediaApp\Resources\123.jpg" Grid.RowSpan="3" Stretch="Fill" Opacity="0.5"/>
        <Border MinWidth="400" Margin="15" Background="#fff" Grid.Row="1" Opacity="1" VerticalAlignment="Center" Padding="30" MaxWidth="550" CornerRadius="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="100" Color="LightGray" ShadowDepth="0"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Авторизация" Foreground="#3F578C" FontFamily="Century Gothic" FontStyle="Italic" FontSize="30" FontWeight="Bold" Margin="0 0 0 20"/>
                <TextBox x:Name="LoginTb" Foreground="#3F578C" Text="{Binding Login}" FontFamily="Century Gothic" FontStyle="Italic" materialDesign:HintAssist.Hint="Введите логин" VerticalAlignment="Center" HorizontalAlignment="Center" Width="450" FontSize="15" Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>
                <PasswordBox x:Name="PasswordPb" Foreground="#3F578C" FontFamily="Century Gothic" FontStyle="Italic" Grid.Row="1" Grid.Column="1" 
                         materialDesign:HintAssist.Hint="Введите пароль" Style="{StaticResource MaterialDesignRevealPasswordBox}" Height="30" Width="450" VerticalAlignment="Center" FontSize="15"/>
                <Grid>
                    <Button x:Name="LoginBtn" Click="LoginBtn_Click" Content="Войти" FontFamily="Century Gothic" FontWeight="Heavy" Background="Transparent" FontStyle="Italic" Foreground="#3F578C" BorderBrush="#3F578C" HorizontalAlignment="Center" Margin="0 20" Width="200" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
