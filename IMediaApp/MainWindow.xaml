<Window x:Class="IMediaApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IMediaApp"
        mc:Ignorable="d"
        Title="Imedia Application" Height="650" Width="1090" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Image Source="\Resources\123.jpg" Grid.RowSpan="3" Grid.ColumnSpan="2" Stretch="Fill" Opacity="0.5"/>
        <Border Background="White" Grid.RowSpan="3" Opacity="0.8"/>
        <Image Source="\Resources\logo.png" Width="150" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16 0 0 0"/>
        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0" Height="300" VerticalAlignment="Top" x:Name="UserSP">
            <Button x:Name="AboutUsBtn" FontSize="11" VerticalAlignment="Center" FontFamily="Century Gothic" FontStyle="Italic" Click="AboutUsBtn_Click" Background="Transparent" Foreground="#3F578C" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0">
                О компании
            </Button>
            <Button x:Name="ServiceBtn" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" FontStyle="Italic" Click="ServiceBtn_Click" FontFamily="Century Gothic" Foreground="#3F578C" Background="Transparent" BorderBrush="Transparent" Width="100" Height="20" Margin="0 16 0 0">
                Услуги
            </Button>
            <Button x:Name="CalcBtn" VerticalAlignment="Center" FontSize="11" HorizontalAlignment="Center" FontStyle="Italic" Click="CalcBtn_Click" FontFamily="Century Gothic" Foreground="#3F578C" Background="Transparent" BorderBrush="Transparent" Width="105" Height="40" Margin="0 16 0 0">
                <TextBlock>
                    Калькулятор<LineBreak/> размещения
                </TextBlock>
            </Button>
            <Button x:Name="TeamBtn" VerticalAlignment="Center" FontSize="11" Background="Transparent" FontStyle="Italic" Click="TeamBtn_Click" FontFamily="Century Gothic" Foreground="#3F578C" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0">
                Команда
            </Button>
            <Button x:Name="PartnerBtn" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="PartnerBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0">
                Партнеры
            </Button>
            <Button x:Name="ContactBtn" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" Click="ContactBtn_Click" FontStyle="Italic" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0">
                Контакты
            </Button>
        </StackPanel>
        <StackPanel x:Name="AdminSP" Orientation="Vertical" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Height="300">
            <Button x:Name="AddressBtn" Content="Адреса" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="AddressBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0"/>
            <Button x:Name="AdvRepBtn"  VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="AdvRepBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0">
                <TextBlock TextAlignment="Center">
                    Фотоотчеты
                </TextBlock>
            </Button>
            <Button x:Name="BuyAdvBtn" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="BuyAdvBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="40" Margin="0 16 0 0">
                <TextBlock TextAlignment="Center">
                    Покупка<LineBreak/> рекламы
                </TextBlock>
            </Button>
            <Button x:Name="ClientBtn" Content="Клиенты" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="ClientBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0"/>
            <Button x:Name="ReportBtn" Content="Отчеты" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="ReportBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0"/>
            <Button x:Name="WorkerBtn" Content="Работники" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="WorkerBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0"/>
            <Button x:Name="PartBtn" Content="Партнеры" VerticalAlignment="Center" FontSize="11" Foreground="#3F578C" FontStyle="Italic" Click="PartBtn_Click" FontFamily="Century Gothic" Background="Transparent" BorderBrush="Transparent" HorizontalAlignment="Center" Width="100" Height="20" Margin="0 16 0 0"/>
        </StackPanel>
        <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Margin="0 0 0 8" FontFamily="Century Gothic" FontStyle="Italic" Foreground="#3F578C" Text="8 (843) 537-93-11" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" VerticalAlignment="Top" Foreground="#3F578C" FontFamily="Century Gothic" FontStyle="Italic" Margin="0 8 0 0" HorizontalAlignment="Center" TextAlignment="Center">
               420012<LineBreak/> г. Казань,<LineBreak/> ул. Декабристов, 85б
        </TextBlock>
        <Frame x:Name="MainFrame" Grid.RowSpan="3" Grid.Column="1" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"/>
        <Button x:Name="LoginBtn" Grid.Row="1" VerticalAlignment="Bottom" Click="LoginBtn_Click" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" HorizontalAlignment="Center" Margin="0 0 0 32" Content="Войти в систему" Foreground="#3F578C" Background="Transparent" BorderBrush="#3F578C" BorderThickness="1"/>
    </Grid>
</Window>
