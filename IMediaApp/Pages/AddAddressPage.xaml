<Page x:Class="IMediaApp.Pages.AddAddressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="AddAddressPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Идентификатор" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"/>
        <TextBlock Text="Улица" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="1"/>
        <TextBlock Text="Дом" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="2"/>
        <TextBlock Text="Район" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="3"/>
        <TextBlock Text="Тип рекламы" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.Row="4"/>

        <Button Click="SaveBtn_Click" x:Name="SaveBtn" Foreground="#3F578C" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Grid.Row="6" Grid.ColumnSpan="2" Content="Сохранить" VerticalAlignment="Center" FontSize="20" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent"/>

        <TextBox Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Text="{Binding AddressID}" Foreground="#3F578C" materialDesign:HintAssist.Hint="Введите идентификатор" Width="300"/>
        <TextBox Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Text="{Binding Street}" Foreground="#3F578C" materialDesign:HintAssist.Hint="Введите название улицы" Width="300"/>
        <TextBox Grid.Column="1" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Text="{Binding House}" Foreground="#3F578C" materialDesign:HintAssist.Hint="Введите номер дома" Width="300"/>
        <ComboBox Grid.Row="3"  Grid.Column="1" x:Name="RegionCb" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" SelectedItem="{Binding Region}" DisplayMemberPath="Name" Foreground="#3F578C"  materialDesign:HintAssist.Hint="Выберите район" Width="300"/>
        <ComboBox Grid.Row="4"  Grid.Column="1" x:Name="TypeCb" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" SelectedItem="{Binding FlyersType}" DisplayMemberPath="Name" Foreground="#3F578C"  materialDesign:HintAssist.Hint="Выберите тип рекламы" Width="300"/>
    </Grid>
</Page>
