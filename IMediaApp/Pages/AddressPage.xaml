<Page x:Class="IMediaApp.Pages.AddressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddressPage" Background="White" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid ItemsSource="{Binding Address}" x:Name="DataAddress" MinColumnWidth="135" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignDataGrid}" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Идентификатор" Binding="{Binding AddressID}"/>
                <DataGridTextColumn Header="Район" Binding="{Binding Region.Name}"/>
                <DataGridTextColumn Header="Улица" Binding="{Binding Street}"/>
                <DataGridTextColumn Header="Дом" Binding="{Binding House}"/>
                <DataGridTextColumn Header="Тип рекламы" Binding="{Binding FlyersType.Name}"/>
                <DataGridTemplateColumn Header="Редактировать" x:Name="EditDGT">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="EditBtn" Click="EditBtn_Click" Content="Edit" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Background="Transparent" Foreground="#3F587C" BorderBrush="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="AddBtn" Content="Добавить" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16 0" Grid.Row="1" Background="Transparent" 
                Foreground="#3F578C" BorderBrush="Transparent" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Click="AddBtn_Click"/>
    </Grid>
</Page>
