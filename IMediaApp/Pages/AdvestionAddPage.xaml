<Page x:Class="IMediaApp.Pages.AdvestionAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdvestionAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Работник" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20 " Foreground="#3F578C" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic"/>
        <TextBlock Text="Адрес" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20 " Foreground="#3F578C" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic"/>
        <Button x:Name="LoadImageBtn" Content="Добавить фото" Grid.Row="2" Foreground="White" Click="LoadImageBtn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Background="#3F578C" BorderBrush="#3F578C"/>
        <Button x:Name="SaveBtn" Content="Сохранить" Grid.Row="3" Grid.ColumnSpan="2" Click="SaveBtn_Click" Foreground="#3F578C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Background="Transparent" BorderBrush="Transparent"/>

        <ComboBox x:Name="WorkerCb" Grid.Row="0" SelectedItem="{Binding Worker}" DisplayMemberPath="Surname" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Width="300" Foreground="#3F578C" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic"/>
        <ComboBox x:Name="AddressCb" Grid.Row="1" SelectedItem="{Binding Address}" DisplayMemberPath="Street" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Width="300" Foreground="#3F578C" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic"/>
        <Image Grid.Row="2" Grid.Column="1" Source="{Binding GetPhoto}" Width="100" Height="100"/>
    </Grid>
</Page>
