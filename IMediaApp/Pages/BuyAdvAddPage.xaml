<Page x:Class="IMediaApp.Pages.BuyAdvAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BuyAdvAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Клиент" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C"/>
        <TextBlock Text="Цена" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C"/>
        <TextBlock Text="Дата заключения" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C"/>
        <TextBlock Text="Дата расторжения" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C"/>
        <TextBlock Text="Услуга" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C"/>

        <Button x:Name="SaveBtn" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="5" Click="SaveBtn_Click" Content="Сохранить" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" Foreground="#3F578C" Background="Transparent" BorderBrush="Transparent"/>
        <ComboBox x:Name="ClientCb" SelectedItem="{Binding Client}" DisplayMemberPath="CompanyName" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="0" Width="250"  FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding Price}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Grid.Column="1" Grid.Row="1" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding DateConclusion}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Grid.Column="1" Grid.Row="2" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding DateCompletion}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Grid.Column="1" Grid.Row="3" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <ComboBox x:Name="ServiceCb" SelectedItem="{Binding Service}" DisplayMemberPath="Name" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Column="1" Grid.Row="4" Width="250"  FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>

    </Grid>
</Page>
