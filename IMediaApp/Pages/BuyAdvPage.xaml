<Page x:Class="IMediaApp.Pages.BuyAdvPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BuyAdvPage" Background="White" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="DataAdvest" HorizontalAlignment="Center" ItemsSource="{Binding BuyAdv}" Style="{StaticResource MaterialDesignDataGrid}" AutoGenerateColumns="False" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.CompanyName}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}"/>
                <DataGridTextColumn Header="Дата заключения" Binding="{Binding DateConclusion}"/>
                <DataGridTextColumn Header="Дата расторжения" Binding="{Binding DateCompletion}"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}"/>
                <DataGridTemplateColumn x:Name="EditBtn" Header="Редактировать">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="EditBtn" Content="Edit" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Click="EditBtn_Click" Foreground="#3F578C" Background="Transparent" BorderBrush="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="AddBtn" Content="Добавить" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16 0" Grid.Row="2" Background="Transparent" 
                Foreground="#3F578C" BorderBrush="Transparent" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Click="AddBtn_Click"/>
    </Grid>
</Page>
