<Page x:Class="IMediaApp.Pages.ClientAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ClientAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="AddBtn" Content="Сохранить" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Grid.Row="4" Grid.ColumnSpan="2" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"  Click="AddBtn_Click" Foreground="#3F578C" Background="Transparent" BorderBrush="Transparent"/>
        <TextBlock Text="Фамилия" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="0"/>
        <TextBlock Text="Имя" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="1"/>
        <TextBlock Text="Отчество" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="2"/>
        <TextBlock Text="Наименование компании" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="3" />

        <TextBox Text="{Binding Surname}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="0"  FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="1" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding Patronymic}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="2" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding CompanyName}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="200" Grid.Column="1" Grid.Row="3" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
    </Grid>
</Page>
