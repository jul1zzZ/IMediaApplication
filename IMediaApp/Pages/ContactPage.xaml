<Page x:Class="IMediaApp.Pages.ContactPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ContactPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="150"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" VerticalAlignment="Bottom" FontStyle="Italic" Margin="16" FontFamily="Century Gothic" Foreground="#3F578C" Text="Контакты" FontSize="18" HorizontalAlignment="Left"/>
        <Line Width="780" Height="1" Stroke="Black" StrokeThickness="4" VerticalAlignment="Bottom" X1="0" X2="5000" Grid.ColumnSpan="3" Margin="0 0 0 5"/>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="0">
            <Image Source="\Resources\1639191597_18-papik-pro-p-telefon-klipart-24.png" Width="40" Margin="0 8 0 0"/>
            <TextBlock Text="Звоните" TextAlignment="Center" Margin="0 16 0 0" FontFamily="Century Gothic" FontStyle="Italic" Foreground="#3F578C" FontSize="20"/>
            <TextBlock Text="8 (843) 537-93-11" Foreground="Gray" TextAlignment="Center" FontSize="20" FontStyle="Italic" FontFamily="Century Gothic" Margin="0 13 0 0"/>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="1">
            <Image Source="\Resources\6454.png" Width="40" Grid.Row="1" Grid.Column="1" Margin="0 8 0 0" VerticalAlignment="Top"/>
            <TextBlock TextAlignment="Center" FontStyle="Italic" Margin="0 16 0 0" FontFamily="Century Gothic" Foreground="Gray" FontSize="20">
                420012, г. Казань,<LineBreak/> ул. Декабристов, 85б
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Vertical" Grid.Row="1" Grid.Column="2">
            <Image Source="\Resources\pngegg.png" Width="40" Margin="0 8 0 0"/>
            <TextBlock Text="Пишите" TextAlignment="Center" FontStyle="Italic" Margin="0 16 0 0" FontFamily="Century Gothic" Foreground="#3F578C" FontSize="20"/>
            <TextBlock Text="imedia@ra-imedia.ru" FontStyle="Italic" Foreground="Gray" TextAlignment="Center" FontSize="20" FontFamily="Century Gothic" Margin="0 13 0 0"/>
        </StackPanel>

        <Border Background="#f0f8ff" Grid.Row="2" Grid.ColumnSpan="3" Width="600" Height="150" >
            <StackPanel Orientation="Vertical" Margin="32 16 425 0">
                <Image Source="\Resources\3125.png" Width="50" Margin="0 8 0 0" />
                <TextBlock Text="Ваш менеджер" Foreground="Gray" FontFamily="Century Gothic" TextAlignment="Center" FontStyle="Italic" Margin="0 8 0 0"/>
                <TextBlock Text="Елена" Foreground="#3F578C" FontFamily="Century Gothic" TextAlignment="Center" FontStyle="Italic" FontWeight="Bold" FontSize="15"/>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Vertical" Grid.Row="2" Margin="16 130 116 64" Grid.ColumnSpan="2" Grid.Column="1">
            <TextBlock Text="У ВАС ОСТАЛИСЬ ВОПРОСЫ?" FontWeight="Bold" FontFamily="Century Gothic" Margin="16 16 0 0" Foreground="#3F578C" FontStyle="Italic"/>
            <TextBlock Text="Оставьте свой номер телефона и мы Вам перезвоним" FontWeight="Bold" FontFamily="Century Gothic" Margin="16 8 0 0" Foreground="#3F578C" FontStyle="Italic"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="NumberTb" Width="150"  Margin="16 16 0 0" Height="20" FontFamily="Century Gothic" FontStyle="Italic" FontSize="11" Foreground="White"/>
                <Button x:Name="CallBtn" Width="150" Height="20" Margin="32 16 0 0" Background="#3F578C" Content="ЖДУ ЗВОНКА" FontFamily="Century Gothic" FontStyle="Italic" Foreground="Gray" FontSize="8" Click="CallBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
