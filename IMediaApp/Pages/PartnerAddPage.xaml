<Page x:Class="IMediaApp.Pages.PartnerAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PartnerAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Наименование компании" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="0"/>
        <TextBlock Text="Описание" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#3F578C" Grid.Row="1"/>
        <Button x:Name="LoadImageBtn" Content="Добавить фото" Grid.Row="2" Foreground="White" Click="LoadImageBtn_Click" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Background="#3F578C" BorderBrush="#3F578C"/>
        <Button x:Name="SaveBtn" Content="Сохранить" Grid.Row="3" Grid.ColumnSpan="2" Click="SaveBtn_Click" Foreground="#3F578C" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Background="Transparent" BorderBrush="Transparent"/>

        <Image Grid.Row="2" Grid.Column="1" Source="{Binding GetPhoto}" Width="100" Height="100"/>
        <TextBox Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Grid.Column="1"  Grid.Row="0"  FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
        <TextBox Text="{Binding Description}" VerticalAlignment="Center" HorizontalAlignment="Center" Width="250" Grid.Column="1" Grid.Row="1"  FontFamily="Century Gothic" FontWeight="Heavy" FontStyle="Italic" Foreground="#3F578C"/>
    </Grid>
</Page>
