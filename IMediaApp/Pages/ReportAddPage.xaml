<Page x:Class="IMediaApp.Pages.ReportAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportAddPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="SaveBtn" Click="SaveBtn_Click" Content="Сохранить" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" Grid.ColumnSpan="2" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Background="Transparent" Foreground="#3F587C" BorderBrush="Transparent"/>
        <TextBlock Text="Работник" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" FontSize="20" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C"/>
        <TextBlock Text="Отчет по работе" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" FontSize="20" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C"/>
        <TextBlock Text="Услуга" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" FontSize="20" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C"/>

        <ComboBox x:Name="WorkCb" SelectedItem="{Binding Worker}" DisplayMemberPath="Surname" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="0" Grid.Column="1"  FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C" Width="250"/>
        <ComboBox x:Name="AdvRepCb" SelectedItem="{Binding AdvestingReport}" DisplayMemberPath="WorkerID" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="1" Grid.Column="1"  FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C" Width="250"/>
        <ComboBox x:Name="ServiceCb" SelectedItem="{Binding Service}" DisplayMemberPath="Name" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"  FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Foreground="#3F587C" Width="250"/>
    </Grid>
</Page>
