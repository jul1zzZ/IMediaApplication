<Page x:Class="IMediaApp.Pages.ReportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:IMediaApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ReportPage" Background="White" IsVisibleChanged="Page_IsVisibleChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="1" x:Name="DataReport" ItemsSource="{Binding Report}" AutoGenerateColumns="False" HorizontalAlignment="Center">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Работник" Binding="{Binding Worker.Surname}"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding AdvestingReport.Address.Street}"/>
                <DataGridTextColumn Header="Услуга" Binding="{Binding Service.Name}"/>
                <DataGridTemplateColumn Header="Edit">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="EditBtn" Click="EditBtn_Click" Content="Edit" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Background="Transparent" Foreground="#3F587C" BorderBrush="Transparent"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="AddBtn" Click="AddBtn_Click" Content="Добавить" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="16 0" FontStyle="Italic" FontFamily="Century Gothic" FontWeight="Heavy" Background="Transparent" Foreground="#3F587C" BorderBrush="Transparent"/>
    </Grid>
</Page>
